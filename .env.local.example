# Copy to .env.local (gitignored) and fill in a real token.
# Never commit .env.local or real tokens.

# Bot token preferred (xoxb-...). Invite the bot to #control-e2e first.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Optional alternative if you use a user token instead:
# SLACK_USER_TOKEN=xoxp-your-user-token

# Optional overrides (defaults are the Control E2E harness):
# SLACK_E2E_CHANNEL_ID=C0BVCSA4T2P
# SLACK_E2E_THREAD_TS=1788808933.776429
